generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?

  accounts Account[]
  sessions Session[]

  profile           UserProfile?
  onboarding        Onboarding?
  services          Service[]
  niches            Niche[]
  offers            Offer[]
  portfolioProjects PortfolioProject[]
  prospects         Prospect[]
  outreachMessages  OutreachMessage[]
  proposals         Proposal[]
  progress          Progress?
  usage             AIUsage[]
  subscriptions     Subscription[]

  plan String @default("FREE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  action String
  count  Int    @default(0)
  period String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, action, period])
}

model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   String
  status String // ACTIVE, PAST_DUE, CANCELED, EXPIRED, INCOMPLETE

  provider               String? // e.g., 'stripe', 'lemonsqueezy'
  providerCustomerId     String?
  providerSubscriptionId String? @unique
  providerOrderId        String?
  providerStoreId        String?
  providerProductId      String?
  providerVariantId      String?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  cancelAtPeriodEnd Boolean   @default(false)
  canceledAt        DateTime?
  endedAt           DateTime?

  updatePaymentMethodUrl String?
  customerPortalUrl      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  skill String?
  bio   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Onboarding {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  skill              String
  experienceLevel    String // Beginner, Some experience, Experienced
  hasClientsBefore   Boolean
  interestedServices String?
  targetClients      String?
  currency           String  @default("USD")
  mainGoal           String?

  isCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Progress {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  hasSkill       Boolean @default(false)
  hasService     Boolean @default(false)
  hasNiche       Boolean @default(false)
  hasOffer       Boolean @default(false)
  hasPortfolio   Boolean @default(false)
  hasProspects   Boolean @default(false)
  hasOutreach    Boolean @default(false)
  hasProposal    Boolean @default(false)
  hasFirstClient Boolean @default(false)

  percentage Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title              String
  description        String?
  targetClients      String?
  problemsSolved     String?
  deliverables       String?
  isBeginnerFriendly Boolean @default(true)

  isSelected Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Niche {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  whyTheyNeed    String?
  commonProblems String?
  exampleClients String?
  opportunity    String?

  isSelected Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Offer {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  headline       String
  targetCustomer String?
  problem        String?
  solution       String?
  deliverables   String?
  timeline       String?
  revisionPolicy String?

  // Package structure stored as JSON string
  packagesData String?

  proposals Proposal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PortfolioProject {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title                String
  practiceClient       String
  industry             String?
  background           String?
  problem              String?
  goal                 String?
  targetAudience       String?
  creativeDirection    String?
  deliverables         String?
  suggestedTools       String?
  successCriteria      String?
  portfolioDescription String?

  isPracticeProject Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Prospect {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String
  industry        String?
  website         String?
  socialUrl       String?
  platform        String?
  location        String?
  contactName     String?
  contactEmail    String?
  observedProblem String?
  notes           String?
  status          String  @default("New") // New, Contacted, Replied, Interested, Proposal Sent, Won, Not Interested

  outreachMessages OutreachMessage[]
  proposals        Proposal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OutreachMessage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  messageType String
  platform    String?
  content     String
  subject     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Proposal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  prospectId String?
  prospect   Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  offerId String?
  offer   Offer?  @relation(fields: [offerId], references: [id], onDelete: SetNull)

  title              String?
  projectDescription String?
  service            String?
  deliverables       String?
  timeline           String?
  price              String?
  currency           String?
  paymentTerms       String?

  content String? // The generated full proposal content

  status String @default("Draft") // Draft, Ready, Sent, Accepted, Declined

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
